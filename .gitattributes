# Filer der køres på Linux (Pi/Debian) skal have LF-linjeskift
*.sh       text eol=lf
*.service  text eol=lf
*.py       text eol=lf
*.conf     text eol=lf
*.path     text eol=lf
*.path    text eol=lf
*.timer   text eol=lf

# Git-hooks og shell-scripts uden endelse skal have LF (Git for Windows kører dem med sh)
.githooks/* text eol=lf

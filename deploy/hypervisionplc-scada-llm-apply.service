[Unit]
Description=Installér, start, stop eller fjern LLM-hjælperen efter anmodning fra HypervisionPLC SCADA (root)

[Service]
Type=oneshot
ExecStart=/usr/local/lib/hypervisionplc-scada/apply-llm.sh
# En LLM-pakke på flere GB skal kontrolleres (SHA256 to gange) og pakkes ud
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hypervisionplc-scada-net /var/lib/hypervisionplc-scada/llm /opt /etc /run/systemd

[Unit]
Description=Anvend en netværksændring fra HypervisionPLC SCADA (root)

[Service]
Type=oneshot
ExecStart=/usr/local/lib/hypervisionplc-scada/apply-config.sh
# Dør scriptet midt i en ændring (timeout, SIGKILL), gendanner --recover den gamle opsætning
ExecStopPost=/usr/local/lib/hypervisionplc-scada/apply-config.sh --recover
# Anvendelse (nmcli med tidsgrænse) + op til 180 s bekræftelse + gendannelse
TimeoutStartSec=600
# Hærdning: kun det scriptet skal bruge er skrivbart
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# /etc/network (ifupdown), resolv.conf og hosts (ifupdown-delen), /run/network (ifup/ifdown-tilstand), /run/NetworkManager (nmcli)
ReadWritePaths=-/var/lib/hypervisionplc-scada-net -/var/lib/hypervisionplc-scada/config -/etc/NetworkManager/system-connections -/run/NetworkManager -/etc/network -/etc/resolv.conf -/etc/hosts -/etc/hostname -/run/network -/run/resolvconf -/run/dhclient -/var/lib/dhcp -/var/lib/dhcpcd
